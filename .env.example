# Server-only Gemini credential. Add the real value through Manus Secrets.
GEMINI_API_KEY=

# Comma-separated emails that receive the protected admin role at registration.
ADMIN_EMAILS=elishao2000@gmail.com

# Manus should set this automatically for the published server.
NODE_ENV=production

# Use a persistent mounted directory for listings, users, sessions, and applications.
DATA_DIR=/data

# Optional explicit file path; leave blank when DATA_DIR is used.
DATABASE_PATH=

# Optional server port; Manus supplies the runtime port when omitted.
PORT=
